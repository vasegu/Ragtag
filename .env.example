# Copy to .env.local and fill in (ask a teammate for the values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend only: put these in .env.secrets.local (never share publicly)
AI_GATEWAY_API_KEY=
AI_BASE_URL=https://ai-gateway.vercel.sh/v1
SUPABASE_SECRET_KEY=

# Mapbox public token (pk.), safe in the browser
NEXT_PUBLIC_MAPBOX_TOKEN=

# Street Brain pipeline: server only. Configure these in the Ragtag Vercel project.
# Decisions uses a direct OpenAI key; the existing Ask gateway settings remain separate.
OPENAI_API_KEY=
COUNCIL_ACCESS_CODE=
PIPELINE_WEBHOOK_SECRET=
DECISION_MODEL=gpt-6-luna
DESCRIPTION_MODEL=gpt-5.4-mini
SUPABASE_ASSESSMENTS_TABLE=street_assessments
SUPABASE_PHOTO_BUCKET=street-brain-photos
SUPABASE_UPLOAD_BUCKET=street-brain-uploads
SUPABASE_BACKTEST_BUCKET=images
